#!/bin/bash
# Audio Tools — Thin entrypoint
set -euo pipefail
IFS=$'\n\t'

cleanup() { :; }
trap cleanup EXIT

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
export AUDIO_TOOLS_BIN_DIR="$DIR"
LIB_DIR="$DIR/../lib"

# Foundation
source "$LIB_DIR/utils/errors.sh"
source "$LIB_DIR/utils/logging.sh"
source "$LIB_DIR/utils/config.sh"
source "$LIB_DIR/utils/progress.sh"

# I/O layer
source "$LIB_DIR/io/filesystem.sh"
source "$LIB_DIR/io/media.sh"
source "$LIB_DIR/io/trash.sh"

# CLI layer (new dispatcher takes precedence)
source "$LIB_DIR/cli/dispatcher.sh"
source "$LIB_DIR/cli/help.sh"
source "$LIB_DIR/cli/completion.sh"

# CLI UI layer (TUI, output formatting, file browser)
source "$LIB_DIR/cli/ui/output.sh"
source "$LIB_DIR/cli/ui/args_parser.sh"
source "$LIB_DIR/cli/ui/progress.sh"
source "$LIB_DIR/cli/ui/tui.sh"
source "$LIB_DIR/cli/ui/file_browser.sh"

# Core modules
source "$LIB_DIR/core/converter.sh"
source "$LIB_DIR/core/cleaner.sh"
source "$LIB_DIR/core/organizer.sh"
source "$LIB_DIR/core/inspector.sh"
source "$LIB_DIR/core/processor.sh"
source "$LIB_DIR/core/deduper.sh"
source "$LIB_DIR/core/validator.sh"

# ── Helpers ──

confirm_or_force() {
    local message="$1"
    if [ "$AUDIO_TOOLS_FORCE" = "yes" ]; then return 0; fi
    log_warn "$message"
    local response
    read -p "  Are you sure? (yes/no): " response
    [ "$response" = "yes" ]
}

trash_file_list() {
    local folder="${1:-.}"; shift
    local trash_count=0 to_delete_count=0 fail_count=0
    while IFS= read -r -d '' file; do
        move_to_trash "$file" "$folder" && status=0 || status=$?
        case $status in
            0) trash_count=$((trash_count + 1));;
            2) to_delete_count=$((to_delete_count + 1));;
            *) fail_count=$((fail_count + 1));;
        esac
    done
    log_info "$trash_count files moved to trash."
    if [ "$to_delete_count" -gt 0 ]; then
        log_info "$to_delete_count files moved to fallback folder."
    fi
    if [ "$fail_count" -gt 0 ]; then
        log_error "$fail_count files could not be moved."
    fi
}

# ── Dependency check ──

check_dependencies() {
    local missing=0
    if ! command -v ffmpeg >/dev/null 2>&1; then log_error "Missing dependency: ffmpeg"; missing=1; fi
    if ! command -v ffprobe >/dev/null 2>&1; then log_error "Missing dependency: ffprobe"; missing=1; fi
    if [ "$missing" -eq 1 ]; then die "$EX_UNAVAILABLE" "Install ffmpeg/ffprobe and try again."; fi
}

# ── Action dispatchers ──

_resolve_all() {
    local dir="${1:-}"
    while IFS= read -r -d '' f; do printf '%s\0' "$f"; done < <(resolve_audio_files "$dir")
}

run_convert() {
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    local files=()
    while IFS= read -r -d '' f; do files+=("$f"); done < <(_resolve_all "$dir")
    if [ ${#files[@]} -gt 0 ]; then
        validate_files_for_action "convert" "${files[@]}" || return 1
    fi
    convert_to_mp3 "$dir"
}

run_remove_short() {
    if [ -z "${AUDIO_TOOLS_THRESHOLD:-}" ]; then die "$EX_USAGE" "Threshold (--threshold) is required for remove-short."; fi
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    local files=()
    while IFS= read -r -d '' file; do files+=("$file"); done < <(get_short_files "$dir" "$AUDIO_TOOLS_THRESHOLD")
    if [ ${#files[@]} -eq 0 ]; then log_info "No short files found."; return 0; fi
    confirm_or_force "This will delete short files." || { log_info "Cancelled."; return 0; }
    init_progress ${#files[@]} "Trashing"
    printf '%s\0' "${files[@]}" | while IFS= read -r -d '' f; do update_progress "$f"; done
    printf '%s\0' "${files[@]}" | trash_file_list "$dir"
    finish_progress $? 0 "done"
}

run_remove_long() {
    if [ -z "${AUDIO_TOOLS_THRESHOLD:-}" ]; then die "$EX_USAGE" "Threshold (--threshold) is required for remove-long."; fi
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    local files=()
    while IFS= read -r -d '' file; do files+=("$file"); done < <(get_long_files "$dir" "$AUDIO_TOOLS_THRESHOLD")
    if [ ${#files[@]} -eq 0 ]; then log_info "No long files found."; return 0; fi
    confirm_or_force "This will delete long files." || { log_info "Cancelled."; return 0; }
    init_progress ${#files[@]} "Trashing"
    printf '%s\0' "${files[@]}" | while IFS= read -r -d '' f; do update_progress "$f"; done
    printf '%s\0' "${files[@]}" | trash_file_list "$dir"
    finish_progress $? 0 "done"
}

run_clean_names() {
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    clean_filenames "$dir"
}

run_scan() {
    local dir="${AUDIO_TOOLS_DIRECTORY:-$(pwd)}"
    scan_audios_subfolders "$dir"
}

run_search() {
    if [ -z "${AUDIO_TOOLS_QUERY:-}" ]; then die "$EX_USAGE" "Query (--query) is required for search."; fi
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    local files=()
    while IFS= read -r -d '' file; do files+=("$file"); done < <(search_audios "$dir" "$AUDIO_TOOLS_QUERY")
    if [ ${#files[@]} -eq 0 ]; then log_info "No files matching '$AUDIO_TOOLS_QUERY' found."; return 0; fi
    local op="${AUDIO_TOOLS_OPERATION:-}"
    if [ -z "$op" ]; then log_error "Operation (--operation) required: delete or extract."; return 1; fi
    case "$op" in
        delete)
            confirm_or_force "This will delete matching files." || { log_info "Cancelled."; return 0; }
            init_progress ${#files[@]} "Deleting"
            printf '%s\0' "${files[@]}" | while IFS= read -r -d '' f; do update_progress "$f"; done
            printf '%s\0' "${files[@]}" | trash_file_list "$dir"
            finish_progress $? 0 "done" ;;
        extract)
            local dest="${AUDIO_TOOLS_DIRECTORY:-$(pwd)}/${AUDIO_TOOLS_QUERY}_extracted"
            mkdir -p "$dest"
            init_progress ${#files[@]} "Extracting to $dest"
            for file in "${files[@]}"; do copy_with_rename "$file" "$dest"; update_progress "$file"; done
            finish_progress ${#files[@]} 0 "extracted to $dest" ;;
        *) die "$EX_USAGE" "Invalid operation '$op'. Use 'delete' or 'extract'." ;;
    esac
}

run_completion() {
    local shell="${AUDIO_TOOLS_COMPLETION_SHELL:-bash}"
    case "$shell" in bash|zsh|fish) generate_completion "$shell" ;; *) die "$EX_USAGE" "Usage: audio-tools completion bash|zsh|fish" ;; esac
}

run_info() {
    local file
    if [ ${#AUDIO_TOOLS_FILES[@]} -gt 0 ]; then
        file="${AUDIO_TOOLS_FILES[0]}"
    else
        file="${AUDIO_TOOLS_DIRECTORY:-$(pwd)}"
    fi
    audio_info "$file"
}

run_stats() {
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    audio_stats "$dir"
}

run_list() {
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    audio_list "$dir"
}

run_normalize() {
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    local files=()
    while IFS= read -r -d '' f; do files+=("$f"); done < <(_resolve_all "$dir")
    if [ ${#files[@]} -gt 0 ]; then
        validate_files_for_action "normalize" "${files[@]}" || return 1
    fi
    audio_normalize "$dir"
}

run_trim_silence() {
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    local files=()
    while IFS= read -r -d '' f; do files+=("$f"); done < <(_resolve_all "$dir")
    if [ ${#files[@]} -gt 0 ]; then
        validate_files_for_action "trim-silence" "${files[@]}" || return 1
    fi
    audio_trim_silence "$dir"
}

run_split_silence() {
    local file
    if [ ${#AUDIO_TOOLS_FILES[@]} -gt 0 ]; then
        file="${AUDIO_TOOLS_FILES[0]}"
    else
        file="${AUDIO_TOOLS_DIRECTORY:-$(pwd)}"
    fi
    [ -f "$file" ] && validate_files_for_action "split-silence" "$file" || true
    audio_split_silence "$file"
}

run_concat() {
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    local files=()
    while IFS= read -r -d '' f; do files+=("$f"); done < <(_resolve_all "$dir")
    if [ ${#files[@]} -lt 2 ]; then
        log_error "Need at least 2 files to concatenate (found ${#files[@]})"; return 1
    fi
    validate_files_for_action "concat" "${files[@]}" || return 1
    audio_concat "$dir"
}

run_find_dupes() {
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    audio_find_dupes "$dir"
}

run_dedup() {
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    local files=()
    while IFS= read -r -d '' f; do files+=("$f"); done < <(_resolve_all "$dir")
    if [ ${#files[@]} -gt 0 ]; then
        validate_files_for_action "dedup" "${files[@]}" || return 1
    fi
    audio_dedup "$dir"
}

run_rename() {
    local dir="${AUDIO_TOOLS_DIRECTORY:-}"
    rename_files "$dir"
}

# ── Main ──

main() {
    # Check dependencies first
    check_dependencies

    # Handle special global flags ONLY if they're the first arg
    case "${1:-}" in
        -h|--help)
            show_help
            exit 0
            ;;
        -V|--version)
            show_version
            exit 0
            ;;
    esac

    # Try new dispatcher first (subcommand style)
    dispatch "$@" && dispatch_status=0 || dispatch_status=$?

    # If dispatch succeeded or returned help/version, we're done
    if [ $dispatch_status -eq 0 ] || [ $dispatch_status -eq 1 ] || [ $dispatch_status -eq 2 ]; then
        return $dispatch_status
    fi

    # No subcommand provided → show interactive menu
    if [ $dispatch_status -eq 3 ]; then
        run_interactive_menu
        return $?
    fi

    # If dispatch failed with exit code, propagate it
    if [ $dispatch_status -ne 0 ]; then
        exit $dispatch_status
    fi
}

main "$@"
